--- /dev/null
+++ b/site/web/js/edition.js
@@ -0,0 +1,220 @@
+// La bulle d'édition de la toile. Le MOTEUR étiquette les éléments de ses dessins : un groupe
+// <g class="prise" data-champs="b h" data-titre="…"> dit quelles DONNÉES il représente — des chemins du cadre Données
+// (data-chemin), séparés par une espace ; un chemin terminé par « / » vaut toutes ses lignes. Un clic, un appui du doigt
+// ou Entrée sur l'élément ouvre la bulle à côté de lui (au téléphone : une feuille en bas de l'écran). Elle montre les
+// LIGNES MÊMES du cadre Données, recopiées à chaque calcul : mêmes champs, mêmes unités, même état, et la saisie part par
+// le même chemin (etabli.js, cablerSaisie). L'écran ne connaît aucun module : il lit des étiquettes. Il ne calcule rien.
+//
+// Le glisser reste au zoom (toile.js) : la bulle ne s'ouvre que sur un APPUI — le pointeur relâché sans avoir bougé de
+// plus de SEUIL pixels, un seul doigt posé.
+const SEUIL = 8;
+const ECART = 12;     // entre l'élément et la bulle, et entre la bulle et le bord de la place libre
+
+export function cablerEdition({ bench, stage, donnees, telephone, cablerSaisie }) {
+  const bulle = document.createElement("div");
+  bulle.className = "bulle";
+  bulle.hidden = true;
+  bulle.setAttribute("role", "dialog");
+  bulle.setAttribute("aria-labelledby", "bulle-titre");
+  const croix = document.querySelector("#zoom .zplein svg.i:last-child");   // l'icône « x » de la page (Lucide)
+  bulle.innerHTML = '<div class="bl-h"><b id="bulle-titre"></b><button type="button" class="pcoll" data-fermer-bulle="1" title="Fermer" '
+    + `aria-label="Fermer">${croix ? croix.outerHTML : "×"}</button></div><div class="bl-autres" hidden></div><div class="bl-corps"></div>`
+    + '<div class="bl-pied">Les champs du cadre Données · le calcul se relance à chaque saisie</div>';
+  bench.append(bulle);
+  const corps = bulle.querySelector(".bl-corps");
+  const titre = bulle.querySelector("#bulle-titre");
+  const autres = bulle.querySelector(".bl-autres");
+  let voisins = [];      // les autres éléments sous le point touché (des couches serrées, une barre dans le béton)
+  cablerSaisie(corps);
+  bulle.addEventListener("click", (ev) => {
+    if (ev.target.closest("[data-fermer-bulle]")) { fermer(true); return; }
+    const v = ev.target.closest("[data-voisin]");
+    if (v && voisins[+v.dataset.voisin]) ouvrir(voisins[+v.dataset.voisin], "voisin");
+  });
+
+  let ouverte = null;   // { vue, champs, rang, titre } : l'élément ouvert, retrouvé dans le dessin reposé après chaque calcul
+
+  // les lignes du cadre Données que nomment les chemins, dans l'ordre du cadre. Une « ligne » est le plus grand
+  // conteneur d'un champ dont TOUS les champs sont demandés (une ligne de saisie, un lit, un trio de moments, une couche
+  // de dalle avec son type, son treillis et son axe) — sans jamais franchir une section du cadre : aucune liste de
+  // classes propre à un module, la règle vaut pour tous.
+  function lignes(champs) {
+    const voulus = champs.split(/\s+/).filter(Boolean);
+    const vise = (c) => voulus.some((v) => (v.endsWith("/") ? c.startsWith(v) : c === v));
+    const pur = (e) => [...e.querySelectorAll("[data-chemin]")].every((x) => vise(x.dataset.chemin));
+    const out = [];
+    donnees.querySelectorAll("[data-chemin]").forEach((el) => {
+      if (!vise(el.dataset.chemin)) return;
+      let l = el;
+      while (l.parentElement && l.parentElement !== donnees && !l.parentElement.matches(".rows, .sec, .secards") && pur(l.parentElement)) l = l.parentElement;
+      if (!out.some((o) => o.contains(l))) out.push(l);
+    });
+    return out;
+  }
+
+  // recopier les lignes ; le champ en cours de frappe survit (comme dans le cadre Données, etabli.js)
+  function remplir() {
+    const el0 = document.activeElement && corps.contains(document.activeElement) ? document.activeElement : null;
+    const actif = el0 ? el0.dataset.chemin : null;
+    const brouillon = el0 && (el0.tagName === "INPUT" || el0.tagName === "TEXTAREA") && el0.type !== "checkbox" && el0.value !== el0.defaultValue
+      ? { valeur: el0.value, debut: el0.selectionStart, fin: el0.selectionEnd } : null;
+    const defile = corps.scrollTop;
+    corps.replaceChildren();
+    let parent = null, groupe = null;
+    for (const l of lignes(ouverte.champs)) {
+      const copie = l.cloneNode(true);
+      // des lignes sœurs dans un conteneur de mise en page (.trio) gardent ce conteneur ; une ligne de .rows va seule
+      if (l.parentElement.matches(".rows")) { corps.append(copie); parent = groupe = null; continue; }
+      if (l.parentElement !== parent) { parent = l.parentElement; groupe = parent.cloneNode(false); corps.append(groupe); }
+      groupe.append(copie);
+    }
+    if (!corps.children.length) corps.innerHTML = '<div class="hint">Rien à saisir pour cet élément.</div>';
+    corps.scrollTop = defile;
+    if (actif) {
+      const el = corps.querySelector(`[data-chemin="${CSS.escape(actif)}"]:not(button)`);
+      if (el) {
+        if (brouillon) el.value = brouillon.valeur;
+        el.focus({ preventScroll: true });
+        if (brouillon) { try { el.setSelectionRange(brouillon.debut, brouillon.fin); } catch (e) { /* champ sans curseur */ } }
+      }
+    }
+  }
+
+  // l'élément ouvert dans le dessin tel qu'il est MAINTENANT (le calcul repose les vues)
+  function element() {
+    if (!ouverte) return null;
+    const vue = stage.querySelector(`.view[data-vue="${CSS.escape(ouverte.vue)}"]`);
+    if (!vue) return null;
+    const memes = vue.querySelectorAll(`.draw [data-champs="${CSS.escape(ouverte.champs)}"]`);
+    return memes[ouverte.rang] || memes[0] || null;
+  }
+
+  // à côté de l'élément, dans la place libre de la toile : à droite, sinon à gauche, sinon dessous ; au téléphone, la
+  // feuille du bas (CSS) — l'élément est alors ramené au-dessus d'elle
+  function placer() {
+    const el = element();
+    stage.querySelectorAll(".prise.sel").forEach((e) => e.classList.remove("sel"));
+    if (!el) { fermer(); return; }
+    el.classList.add("sel");
+    bulle.classList.toggle("feuille", telephone.matches);
+    if (telephone.matches) {
+      bulle.style.left = bulle.style.top = "";
+      const a = el.getBoundingClientRect(), haut = innerHeight - bulle.offsetHeight - ECART;
+      if (a.bottom > haut) scrollBy({ top: Math.min(a.bottom - haut, a.top - 60), behavior: "smooth" });
+      return;
+    }
+    const b = bench.getBoundingClientRect(), s = stage.getBoundingClientRect();
+    let a = el.getBoundingClientRect();
+    // un GRAND élément (le béton d'une section) : la bulle se pose à côté du point touché, comme un menu — posée à côté
+    // de l'élément entier, elle couvrait le reste du dessin. Le point est gardé en fraction de l'élément : le dessin
+    // reposé après un calcul change d'échelle, le point le suit.
+    if (ouverte.point && a.width * a.height > bulle.offsetWidth * bulle.offsetHeight / 2) {
+      const px = a.left + ouverte.point.fx * a.width, py = a.top + ouverte.point.fy * a.height;
+      a = { left: px - 4, right: px + 4, top: py - 4, bottom: py + 4, width: 8, height: 8 };
+    }
+    let g = Math.max(s.left, 0), d = Math.min(s.right, innerWidth);
+    const haut = Math.max(s.top, 0), bas = Math.min(s.bottom, innerHeight);
+    // les cadres flottants (PC) recouvrent la toile : la place libre est entre eux
+    for (const p of bench.querySelectorAll(".panel")) {
+      const r = p.getBoundingClientRect();
+      if (r.width < 60 || r.bottom < haut || r.top > bas || r.right <= g || r.left >= d) continue;
+      if (r.left + r.width / 2 < (s.left + s.right) / 2) g = Math.max(g, r.right); else d = Math.min(d, r.left);
+    }
+    // quatre places (à droite, à gauche, dessous, dessus), chacune ramenée dans la place libre ; on garde celle qui
+    // couvre le moins l'élément (à égalité, dans cet ordre)
+    const w = bulle.offsetWidth, h = bulle.offsetHeight;
+    const cx = a.left + a.width / 2, cy = a.top + a.height / 2;
+    const dans = ([x, y]) => [Math.min(Math.max(x, g + ECART), d - ECART - w), Math.min(Math.max(y, haut + ECART), bas - ECART - h)];
+    const couvre = ([x, y]) => Math.max(0, Math.min(x + w, a.right) - Math.max(x, a.left)) * Math.max(0, Math.min(y + h, a.bottom) - Math.max(y, a.top));
+    const places = [[a.right + ECART, cy - h / 2], [a.left - ECART - w, cy - h / 2], [cx - w / 2, a.bottom + ECART], [cx - w / 2, a.top - ECART - h]].map(dans);
+    const [x, y] = places.reduce((m, p) => (couvre(p) < couvre(m) - 1 ? p : m));
+    bulle.style.left = `${Math.round(x - b.left)}px`;
+    bulle.style.top = `${Math.round(y - b.top)}px`;
+  }
+
+  function ouvrir(el, sorte, x, y) {
+    const vue = el.closest(".view");
+    const memes = [...vue.querySelectorAll(`.draw [data-champs="${CSS.escape(el.dataset.champs)}"]`)];
+    const r = el.getBoundingClientRect();
+    const point = x === undefined || !r.width || !r.height ? null : { fx: (x - r.left) / r.width, fy: (y - r.top) / r.height };
+    if (sorte !== "voisin") {
+      // tous les éléments sous le point, du dessus vers le dessous ; celui qu'on ouvre d'abord est le plus haut
+      const sous = x === undefined ? [] : document.elementsFromPoint(x, y).map((e) => e.closest(".prise")).filter((p) => p && vue.contains(p));
+      voisins = [...new Set([el, ...sous])];
+    }
+    ouverte = { vue: vue.dataset.vue, champs: el.dataset.champs, rang: memes.indexOf(el), titre: el.dataset.titre || "", point: point || ouverte?.point || null };
+    titre.textContent = ouverte.titre;
+    autres.hidden = voisins.length < 2;
+    autres.innerHTML = voisins.length < 2 ? "" : '<span>Aussi ici :</span>' + voisins.map((p, k) => (p === el ? ""
+      : `<button type="button" class="fchip" data-voisin="${k}"></button>`)).join("");
+    autres.querySelectorAll("[data-voisin]").forEach((b) => { b.textContent = voisins[+b.dataset.voisin].dataset.titre || ""; });
+    remplir();
+    bulle.hidden = false;
+    placer();
+    if (!ouverte) return;
+    // à la souris et au clavier, le premier champ prend la main ; au doigt, non (le clavier de l'écran cacherait le dessin)
+    if (sorte === "mouse" || sorte === "clavier") {
+      const c = corps.querySelector("input:not([disabled]):not([type=checkbox]), select:not([disabled])");
+      if (c) { c.focus({ preventScroll: true }); if (c.select) c.select(); }
+    }
+  }
+
+  // Échap : le brouillon en cours est abandonné (il ne part pas au moteur en quittant le champ), la main revient au dessin
+  function fermer(rendre = false) {
+    if (!ouverte) return;
+    const el = element();
+    const actif = document.activeElement;
+    if (actif && corps.contains(actif) && "defaultValue" in actif) actif.value = actif.defaultValue;
+    ouverte = null;
+    bulle.hidden = true;
+    stage.querySelectorAll(".prise.sel").forEach((e) => e.classList.remove("sel"));
+    if (rendre && el) el.focus({ preventScroll: true });
+  }
+
+  // ------------------------------------------------------------------ l'appui (et non le glisser)
+  const poses = new Set();
+  let appui = null;
+  stage.addEventListener("pointerdown", (ev) => {
+    poses.add(ev.pointerId);
+    if (poses.size > 1 || (ev.pointerType === "mouse" && ev.button !== 0)) { appui = null; return; }   // pincer
+    if (!ev.target.closest(".view.on .draw")) { appui = null; return; }
+    appui = { id: ev.pointerId, x: ev.clientX, y: ev.clientY, el: ev.target.closest("[data-champs]") };
+  });
+  stage.addEventListener("pointermove", (ev) => {
+    if (appui && ev.pointerId === appui.id && Math.hypot(ev.clientX - appui.x, ev.clientY - appui.y) > SEUIL) appui = null;
+    if (ouverte && poses.size) requestAnimationFrame(placer);     // le dessin glisse ou se pince : la bulle le suit
+  });
+  const lacher = (ev) => {
+    poses.delete(ev.pointerId);
+    const a = appui;
+    if (!a || ev.pointerId !== a.id) return;
+    appui = null;
+    if (ev.type !== "pointerup") return;
+    if (a.el) ouvrir(a.el, ev.pointerType, ev.clientX, ev.clientY);
+    else fermer();                                               // un appui sur le fond du dessin referme
+  };
+  document.addEventListener("pointerup", lacher);
+  document.addEventListener("pointercancel", lacher);
+  stage.addEventListener("wheel", () => { if (ouverte) requestAnimationFrame(placer); }, { passive: true });
+  document.querySelector("#zoom")?.addEventListener("click", () => { if (ouverte) requestAnimationFrame(placer); });
+  new ResizeObserver(() => { if (ouverte) placer(); }).observe(stage);
+
+  // au clavier : Tab parcourt les éléments du dessin (tabindex du moteur), Entrée ou Espace ouvre
+  stage.addEventListener("keydown", (ev) => {
+    const el = ev.target.closest && ev.target.closest(".view.on .draw [data-champs]");
+    if (!el || (ev.key !== "Enter" && ev.key !== " ")) return;
+    ev.preventDefault();
+    ouvrir(el, "clavier");
+  });
+
+  // un geste hors de la toile et de la bulle (le cadre Données, un onglet, la barre des vues) la referme
+  document.addEventListener("pointerdown", (ev) => {
+    if (ouverte && !bulle.contains(ev.target) && !stage.contains(ev.target)) fermer();
+  });
+
+  return {
+    // après chaque calcul : les lignes recopiées de nouveau, la bulle replacée à côté de l'élément reposé
+    rafraichir() { if (!ouverte) return; remplir(); placer(); },
+    fermer,
+  };
+}
